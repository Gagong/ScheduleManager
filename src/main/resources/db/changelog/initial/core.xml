    <changeSet id="CREATE EMPLOYEE TABLE" author="sm">
        <createTable tableName="EMPLOYEE">
            <!--Base fields-->
            <column name="ID" remarks="ID записи" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="VSTAMP" type="NUMBER(19)" defaultValue="0"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="CREATED_DATE" remarks="Дата создания записи" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="UPDATE_DATE" remarks="Дата обновления записи" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY_EMPLOYEE_ID" remarks="Создатель записи" type="BIGINT" defaultValue="1">
                <constraints
                        nullable="false"
                        referencedTableName="EMPLOYEE"
                        referencedColumnNames="ID"
                        foreignKeyName="FK__EMPLOYEE__CREATED_BY_EMPLOYEE_ID__EMPLOYEE__ID"
                />
            </column>
            <column name="UPDATED_BY_EMPLOYEE_ID" remarks="Обновляющий запись" type="BIGINT" defaultValue="1">
                <constraints
                        nullable="false"
                        referencedTableName="EMPLOYEE"
                        referencedColumnNames="ID"
                        foreignKeyName="FK__EMPLOYEE__UPDATED_BY_EMPLOYEE_ID__EMPLOYEE__ID"
                />
            </column>

            <!--Custom fields-->
            <column name="USERNAME" remarks="Логин" type="VARCHAR2(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="PASSWORD" remarks="Пароль" type="VARCHAR2(255)">
                <constraints nullable="false"/>
            </column>
            <column name="EMAIL" remarks="E-Mail" type="VARCHAR2(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="FIRST_NAME" remarks="Имя" type="VARCHAR2(255)">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_NAME" remarks="Фамилия" type="VARCHAR2(255)">
                <constraints nullable="false"/>
            </column>
            <column name="MIDDLE_NAME" remarks="Отчество" type="VARCHAR2(255)"/>

            <column name="ENABLED" remarks="Активность УЗ" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="ACCOUNT_NON_EXPIRED" remarks="УЗ не устарела" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="ACCOUNT_NON_LOCKED" remarks="УЗ не заблокирована" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="CREDENTIALS_NON_EXPIRED" remarks="Данные для входа не устарели" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="EMPLOYEE" indexName="EMPLOYEE_CREATED_BY_EMPLOYEE_ID_IDX">
            <column name="CREATED_BY_EMPLOYEE_ID"/>
        </createIndex>
        <createIndex tableName="EMPLOYEE" indexName="EMPLOYEE_UPDATED_BY_EMPLOYEE_ID_IDX">
            <column name="UPDATED_BY_EMPLOYEE_ID"/>
        </createIndex>

        <createIndex tableName="EMPLOYEE" indexName="EMPLOYEE_USERNAME_IDX">
            <column name="USERNAME"/>
        </createIndex>
        <createIndex tableName="EMPLOYEE" indexName="EMPLOYEE_EMAIL_IDX">
